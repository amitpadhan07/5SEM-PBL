# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vrap?retryWrites=true&w=majority

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
OTP_EXPIRY=10

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Email Configuration (Brevo SMTP or Standard SMTP)
# Option A: Brevo SMTP
BREVO_SMTP_USER=your_brevo_account_login_email@domain.com
BREVO_API_KEY=your_brevo_smtp_master_key_or_api_key
BREVO_SENDER_EMAIL=noreply@college.edu
BREVO_SENDER_NAME=College Venue Management

# Option B: Standard SMTP (Gmail, Mailtrap, AWS SES, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="College Venue Management <noreply@college.edu>"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# College Information
NEXT_PUBLIC_COLLEGE_NAME=Your College Name
NEXT_PUBLIC_COLLEGE_WEBSITE=https://college.edu
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Admin Configuration
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=admin_initial_password

# Request Expiry (in hours)
REQUEST_EXPIRY_HOURS=48

# Cron Job Secret
CRON_SECRET=your_cron_secret_key_for_webhook

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
